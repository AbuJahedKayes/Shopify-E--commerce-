<section class="max-w-[1400px] mx-auto px-4 md:px-8 py-16">
  <div class="border border-[#4a3129] bg-[#e3dbcf]/50 p-6 md:p-12 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
    <!-- Left Text -->
    <div class="space-y-4">
      <span class="inline-block px-3 py-1 bg-[#4a3129] text-[#f4f1eb] text-[10px] font-bold uppercase tracking-widest">
        {{ section.settings.badge | default: "Brand Philosophy" }}
      </span>
      <h2 class="font-serif text-3xl md:text-5xl text-[#5d4037] leading-tight">
        {{ section.settings.title | default: "Soft as Moss. Durable as Stone." }}
      </h2>
      <p class="text-sm md:text-base text-[#4a3129]/90 leading-relaxed">
        {{ section.settings.text | default: "We engineer heavy-gauge organic cotton and water-resistant outerwear meant to withstand daily life while offering supreme comfort." }}
      </p>
    </div>

    <!-- Right Craftsmanship Video Player -->
    <div class="relative w-full aspect-video border border-[#4a3129] overflow-hidden bg-[#4a3129]">
      {% if section.settings.video_url != blank %}
        <video autoplay loop muted playsinline class="w-full h-full object-cover">
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {% else %}
        <video autoplay loop muted playsinline class="w-full h-full object-cover">
          <source src="https://assets.mixkit.co/videos/preview/mixkit-sewing-machine-working-on-a-garment-41566-large.mp4" type="video/mp4">
        </video>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Ethos & Video",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Brand Philosophy"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Soft as Moss. Durable as Stone."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text",
      "default": "We engineer heavy-gauge organic cotton and water-resistant outerwear meant to withstand daily life while offering supreme comfort."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Direct MP4 Video URL"
    }
  ],
  "presets": [
    {
      "name": "Brand Ethos & Video"
    }
  ]
}
{% endschema %}
